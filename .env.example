# ============================================================
# Oxygen License Server Configuration
# https://lizensierung.modernewolke.de
# ============================================================

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Directory for SQLite database (licenses.db)
DATA_DIR=/data

# Admin Authentication (Initialer Admin-Benutzer)
# E-Mail-Adresse und Passwort für den ersten Login.
# Beim ersten Login wird automatisch das 2FA/TOTP-Setup mit QR-Code aufgerufen!
ADMIN_EMAIL=admin@modernewolke.de
ADMIN_PASSWORD=bitte-ein-sicheres-passwort-hier-eintragen

# Optional: Bei 'true' wird der 2FA/TOTP-Schlüssel zurückgesetzt und beim nächsten Login neu eingerichtet
RESET_ADMIN_TOTP=false

# Cryptographic Signing Secret
# Geheimer Schlüssel zur Erzeugung kryptografischer HMAC-SHA256 Signaturen für ausgestellte Lizenzen
# Kann generiert werden mit: openssl rand -hex 32
SIGNING_SECRET=bitte-einen-langen-zufaelligen-secret-key-hier-generieren

# Session Expiry in Hours (default: 48)
SESSION_EXPIRE_HOURS=48

# CORS (kommagetrennte Liste oder * für alle)
CORS_ORIGINS=*
